# Database Connection
DATABASE_URL="file:./dev.db"

# AI Provider Configuration
# Supported values: "demo", "gemini", "openai"
AI_PROVIDER="demo"

# API Keys (Optional - Application defaults to Demo AI Mode if missing)
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# Email Provider Configuration (Optional - Defaults to Demo Email Mode if unconfigured)
# Resend Integration
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="CareerPilot AI <applications@yourdomain.com>"

# Gmail OAuth Integration
GMAIL_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-client-secret"
GMAIL_REFRESH_TOKEN="your-refresh-token"
GMAIL_USER_EMAIL="your-email@gmail.com"

# Outlook / Microsoft Graph Integration
OUTLOOK_CLIENT_ID="your-azure-app-id"
OUTLOOK_CLIENT_SECRET="your-azure-client-secret"
OUTLOOK_REFRESH_TOKEN="your-refresh-token"
OUTLOOK_USER_EMAIL="your-email@outlook.com"

# Daily Email Send Limit
DAILY_EMAIL_LIMIT="20"
